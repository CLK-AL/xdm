<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="XDM.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:XDM.Maui.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="XDM">

    <FlyoutItem Title="Downloads" Icon="download.png">
        <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="settings.png">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

</Shell>
